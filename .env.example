# ─────────────────────────────────────────────────────────────────────────────
# MedConnect Saudi — web frontend environment
# Every VITE_* variable is PUBLIC: it is compiled into the browser bundle.
# Never put secrets (API keys, video provider secrets, payment secrets) here.
# ─────────────────────────────────────────────────────────────────────────────

# "http" talks to the Laravel API; "mock" uses the in-browser mock adapter (src/mocks).
VITE_API_MODE=http

# Origin of the Laravel backend. Leave empty to use the same origin as the SPA
# (recommended: in dev the Vite proxy forwards /api, /sanctum, /broadcasting).
VITE_API_BASE_URL=

# API prefix. All endpoints are versioned under this path.
VITE_API_PREFIX=/api/v1

# Public app URL (used for canonical / social metadata).
VITE_APP_URL=http://localhost:5173

# Laravel Reverb public connection settings (the app KEY is public; the SECRET is not).
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
VITE_BROADCAST_AUTH_ENDPOINT=/broadcasting/auth

# Dev only (not exposed to the browser): Laravel server the Vite proxy forwards to.
DEV_BACKEND_URL=http://localhost:8000
